--!strict
-- Owns all display state: polls niri, applies changes, arms the keep/revert
-- countdown and manages kanshi profiles. Widget and panel only render the
-- "snap" state and send requests through the "cmd" state key, since entries
-- cannot call each other.
-- IPC: noctalia msg plugin mic92/display-config:service all <event> [payload]

local types = require("./types.luau")
type Mode = types.Mode
type Output = types.Output
type Profile = types.Profile
type Snap = types.Snap
type Saved = types.Saved

local PANEL = "mic92/display-config:panel"
local MANAGED_HEADER = "# Generated by noctalia display-config; do not edit, changes will be overwritten.\n"
  .. "# Add `include ~/.config/kanshi/noctalia.conf` to your main kanshi config.\n\n"

local snap: Snap = {
  state = "loading",
  error = "",
  outputs = {},
  hotplugMs = 0,
  revertLeft = 0,
  kanshi = { enabled = false, available = false, active = "", profiles = {}, included = true },
}

local fetching = false
local fetchQueued = false
local nextPoll = 0
local busy = false
local queue: { { string } } = {}
local revertSnapshot: { Saved }? = nil
local revertDeadline = 0
local lastShape = ""

local function publish()
  noctalia.state.set("snap", snap)
end

local function fmtNum(n: number): string
  return (string.format("%.3f", n):gsub("0+$", ""):gsub("%.$", ""))
end

local function isInternal(name: string): boolean
  local n = name:lower()
  return n:sub(1, 3) == "edp" or n:sub(1, 4) == "lvds" or n:sub(1, 3) == "dsi"
end

-- niri's JSON uses serde variant names; its CLI and kanshi want kebab-case.
local TRANSFORMS: { [string]: string } = {
  Normal = "normal",
  ["90"] = "90",
  ["180"] = "180",
  ["270"] = "270",
  Flipped = "flipped",
  Flipped90 = "flipped-90",
  Flipped180 = "flipped-180",
  Flipped270 = "flipped-270",
}

local function normalize(json: any): { Output }
  local list: { Output } = {}
  for name, o in json do
    local modes: { Mode } = {}
    local current = ""
    for i, m in o.modes or {} do
      local mode: Mode = {
        key = `{m.width}x{m.height}@{fmtNum(m.refresh_rate / 1000)}`,
        width = m.width,
        height = m.height,
        refresh = m.refresh_rate / 1000,
        preferred = m.is_preferred == true,
      }
      table.insert(modes, mode)
      -- current_mode indexes the unsorted list.
      if o.current_mode == i - 1 then
        current = mode.key
      end
    end
    table.sort(modes, function(a: Mode, b: Mode): boolean
      if a.width * a.height ~= b.width * b.height then
        return a.width * a.height > b.width * b.height
      end
      return a.refresh > b.refresh
    end)
    local logical = o.logical
    table.insert(list, {
      name = name,
      make = o.make or "",
      model = o.model or "",
      serial = if type(o.serial) == "string" then o.serial else "",
      enabled = current ~= "" and logical ~= nil,
      mode = current,
      modes = modes,
      scale = if logical then logical.scale else 1,
      x = if logical then logical.x else 0,
      y = if logical then logical.y else 0,
      transform = if logical then TRANSFORMS[tostring(logical.transform)] or "normal" else "normal",
    })
  end
  table.sort(list, function(a: Output, b: Output): boolean
    return a.name < b.name
  end)
  return list
end

local function findOutput(name: string): Output?
  for _, o in snap.outputs do
    if o.name == name then
      return o
    end
  end
  return nil
end

-- Logical (post-scale, post-rotation) size, which is what niri positions in.
local function logicalSize(o: Output): (number, number)
  local m: Mode? = nil
  for _, c in o.modes do
    if c.key == o.mode then
      m = c
    end
  end
  if m == nil then
    for _, c in o.modes do
      if c.preferred and m == nil then
        m = c
      end
    end
  end
  if m == nil then
    m = o.modes[1]
  end
  if m == nil then
    return 1920, 1080
  end
  local rot = o.transform:find("90") ~= nil or o.transform:find("270") ~= nil
  local w = if rot then m.height else m.width
  local h = if rot then m.width else m.height
  return math.round(w / o.scale), math.round(h / o.scale)
end

---------------------------------------------------------------------------
-- kanshi

local function kanshiDir(): string
  local dir = noctalia.getConfig("kanshiConfigDir")
  if type(dir) == "string" and dir ~= "" then
    return noctalia.expandPath(dir)
  end
  local xdg = noctalia.getenv("XDG_CONFIG_HOME") or ""
  if xdg == "" then
    xdg = noctalia.expandPath("~/.config")
  end
  return xdg .. "/kanshi"
end

local function managedPath(): string
  return kanshiDir() .. "/noctalia.conf"
end

local function profileNames(text: string): { string }
  local out = {}
  for line in (text .. "\n"):gmatch("([^\n]*)\n") do
    local name = line:match("^%s*profile%s+([^%s{]+)")
    if name ~= nil then
      table.insert(out, name)
    end
  end
  return out
end

local function readKanshiFiles()
  local k = snap.kanshi
  k.enabled = noctalia.getConfig("kanshiEnabled") == true
  if not k.enabled then
    return
  end
  local managed = noctalia.readFile(managedPath()) or ""
  local main = noctalia.readFile(kanshiDir() .. "/config") or ""
  local seen: { [string]: boolean } = {}
  local profiles: { Profile } = {}
  for _, n in profileNames(managed) do
    seen[n] = true
    table.insert(profiles, { name = n, managed = true })
  end
  for _, n in profileNames(main) do
    if not seen[n] then
      seen[n] = true
      table.insert(profiles, { name = n, managed = false })
    end
  end
  k.profiles = profiles
  k.included = main:find("include%s+[^\n]*noctalia%.conf") ~= nil
end

local function kanshiStatus()
  if not snap.kanshi.enabled then
    return
  end
  noctalia.runAsync({ "kanshictl", "status" }, function(res: CommandResult)
    snap.kanshi.available = res.exitCode == 0
    -- kanshictl prints "Current profile: <name>"; some builds emit JSON.
    local out = res.stdout
    local decoded: any = noctalia.json.decode(out)
    local active = if type(decoded) == "table" then decoded.current_profile else out:match("Current profile:%s*(%S+)")
    snap.kanshi.active = if type(active) == "string" then active else ""
    publish()
  end, 5000)
end

-- External monitors are matched by make/model/serial so profiles survive
-- dock port shuffles; internal panels keep their stable connector name.
local function renderProfile(name: string): string
  local lines = { `profile {name} \{` }
  for _, o in snap.outputs do
    local crit = o.name
    if not isInternal(o.name) and o.serial ~= "" then
      local make = if o.make ~= "" then o.make else "Unknown"
      local model = if o.model ~= "" then o.model else "Unknown"
      crit = `"{make} {model} {o.serial}"`
    end
    local parts = { "  output", crit }
    if o.enabled then
      table.insert(parts, "enable")
      table.insert(parts, "mode " .. o.mode)
      table.insert(parts, `position {o.x},{o.y}`)
      table.insert(parts, "scale " .. fmtNum(o.scale))
      if o.transform ~= "normal" then
        table.insert(parts, "transform " .. o.transform)
      end
    else
      table.insert(parts, "disable")
    end
    table.insert(lines, table.concat(parts, " "))
  end
  table.insert(lines, "}")
  return table.concat(lines, "\n") .. "\n"
end

-- The managed file only holds blocks we wrote (no nested braces), so
-- splitting on top-level "profile NAME {" ... "}" is a sufficient parser.
local function managedBlocks(): ({ string }, { [string]: string })
  local order: { string } = {}
  local blocks: { [string]: string } = {}
  local text = noctalia.readFile(managedPath()) or ""
  for name, body in text:gmatch("profile%s+([^%s{]+)%s*(%b{})") do
    table.insert(order, name)
    blocks[name] = `profile {name} {body}\n`
  end
  return order, blocks
end

local function writeManaged(order: { string }, blocks: { [string]: string }): boolean
  local parts = { MANAGED_HEADER }
  for _, n in order do
    if blocks[n] ~= nil then
      table.insert(parts, blocks[n])
    end
  end
  noctalia.mkdirAll(kanshiDir())
  local tmp = managedPath() .. ".tmp"
  local ok, err = noctalia.writeFile(tmp, table.concat(parts))
  if ok then
    ok, err = noctalia.renameFile(tmp, managedPath())
  end
  if not ok then
    noctalia.notifyError(noctalia.tr("toast.kanshi"), tostring(err))
    return false
  end
  return true
end

local function kanshictl(args: { string })
  local argv = { "kanshictl" }
  for _, a in args do
    table.insert(argv, a)
  end
  noctalia.runAsync(argv, function(res: CommandResult)
    if res.exitCode ~= 0 then
      local msg = noctalia.string.trim(res.stderr .. res.stdout)
      noctalia.notifyError(noctalia.tr("toast.kanshi"), if msg ~= "" then msg else "kanshictl failed")
    end
    readKanshiFiles()
    kanshiStatus()
    publish()
  end, 10000)
end

local function validProfileName(name: string): boolean
  return name:match("^[%w._+-]+$") ~= nil
end

local function kanshiSave(name: string)
  if not validProfileName(name) then
    noctalia.notifyError(noctalia.tr("toast.kanshi"), noctalia.tr("toast.invalid-name"))
    return
  end
  if #snap.outputs == 0 then
    return
  end
  local order, blocks = managedBlocks()
  if blocks[name] == nil then
    table.insert(order, name)
  end
  blocks[name] = renderProfile(name)
  if writeManaged(order, blocks) then
    noctalia.notify(noctalia.tr("toast.kanshi"), noctalia.tr("toast.saved", { name = name } :: any))
    kanshictl({ "reload" })
  end
end

local function kanshiDelete(name: string)
  local order, blocks = managedBlocks()
  if blocks[name] == nil then
    return
  end
  blocks[name] = nil
  if writeManaged(order, blocks) then
    kanshictl({ "reload" })
  end
end

---------------------------------------------------------------------------
-- niri

local fetch: () -> ()

local function finishFetch(outputs: { Output }?, err: string?)
  fetching = false
  if outputs ~= nil then
    -- A freshly plugged monitor often shows up disabled, so the shape
    -- includes every connector, not only lit ones.
    local shape = {}
    for _, o in outputs do
      table.insert(shape, o.name .. (if o.enabled then "+" else "-"))
    end
    local s = table.concat(shape, ",")
    if lastShape ~= "" and s ~= lastShape then
      snap.hotplugMs = noctalia.nowMs()
    end
    lastShape = s
    snap.outputs = outputs
    snap.state = "ok"
    snap.error = ""
  else
    snap.state = "error"
    snap.error = err or "?"
    noctalia.log("display-config: " .. snap.error)
  end
  readKanshiFiles()
  publish()
  kanshiStatus()
  if fetchQueued then
    fetchQueued = false
    fetch()
  end
end

fetch = function()
  if fetching then
    fetchQueued = true
    return
  end
  fetching = true
  nextPoll = os.time() + noctalia.getConfig("pollInterval")
  local started = noctalia.runAsync({ "niri", "msg", "-j", "outputs" }, function(res: CommandResult)
    if res.exitCode ~= 0 then
      local msg = noctalia.string.trim(res.stderr)
      finishFetch(nil, if msg ~= "" then msg else `niri exited {res.exitCode}`)
      return
    end
    local json: any, err = noctalia.json.decode(res.stdout)
    if type(json) ~= "table" then
      finishFetch(nil, "parse error: " .. tostring(err))
      return
    end
    finishFetch(normalize(json), nil)
  end, 5000)
  if not started then
    finishFetch(nil, "cannot start niri")
  end
end

-- Commands run one at a time so `on` lands before `position` etc.
local function runQueue()
  if busy then
    return
  end
  local argv = table.remove(queue, 1)
  if argv == nil then
    fetch()
    return
  end
  busy = true
  noctalia.runAsync(argv, function(res: CommandResult)
    busy = false
    if res.exitCode ~= 0 then
      local msg = noctalia.string.trim(res.stderr)
      noctalia.log("display-config: " .. table.concat(argv, " ") .. ": " .. msg)
      noctalia.notifyError(noctalia.tr("toast.apply-failed"), msg)
    end
    runQueue()
  end, 10000)
end

local function niri(name: string, ...: string)
  table.insert(queue, { "niri", "msg", "output", name, ... })
end

local function enqueueSaved(s: Saved)
  if not s.enabled then
    niri(s.name, "off")
    return
  end
  niri(s.name, "on")
  if s.mode ~= "" then
    niri(s.name, "mode", s.mode)
  end
  niri(s.name, "scale", fmtNum(s.scale))
  niri(s.name, "transform", s.transform)
  niri(s.name, "position", "set", "--", tostring(s.x), tostring(s.y))
end

local function takeSnapshot(): { Saved }
  local out: { Saved } = {}
  for _, o in snap.outputs do
    table.insert(out, {
      name = o.name,
      enabled = o.enabled,
      mode = o.mode,
      scale = o.scale,
      x = o.x,
      y = o.y,
      transform = o.transform,
    })
  end
  return out
end

-- A bad mode can black out the only screen, so every change must be
-- confirmed or it rolls back. The earliest snapshot of a burst of edits
-- wins, so revert restores the state before the user started.
local function armRevert()
  local secs = noctalia.getConfig("revertSeconds")
  if revertSnapshot == nil then
    revertSnapshot = takeSnapshot()
  end
  revertDeadline = os.time() + secs
  snap.revertLeft = secs
  publish()
end

local function keep()
  revertSnapshot = nil
  snap.revertLeft = 0
  publish()
end

local function revert()
  local saved = revertSnapshot
  keep()
  if saved == nil then
    return
  end
  for _, s in saved do
    -- Light outputs first so we never pass through a zero-screen state.
    if s.enabled then
      enqueueSaved(s)
    end
  end
  for _, s in saved do
    if not s.enabled then
      enqueueSaved(s)
    end
  end
  runQueue()
  noctalia.notify(noctalia.tr("toast.reverted"), noctalia.tr("toast.reverted-body"))
end

local function setOutput(name: string, opts: any)
  local o = findOutput(name)
  if o == nil then
    return
  end
  armRevert()
  if opts.enabled == false then
    niri(name, "off")
  else
    if opts.enabled == true then
      niri(name, "on")
    end
    if type(opts.mode) == "string" then
      niri(name, "mode", opts.mode)
    end
    if type(opts.scale) == "number" then
      niri(name, "scale", fmtNum(opts.scale))
    end
    if type(opts.transform) == "string" then
      niri(name, "transform", opts.transform)
    end
  end
  runQueue()
end

local function pair(): (Output?, Output?)
  if #snap.outputs ~= 2 then
    return nil, nil
  end
  local a, b = snap.outputs[1], snap.outputs[2]
  if isInternal(b.name) and not isInternal(a.name) then
    return b, a
  end
  return a, b
end

-- Positions come from logical sizes so edges touch and the pointer crosses
-- cleanly; everything stays in the +x/+y quadrant.
local function arrange(kind: string)
  local a, b = pair()
  if a == nil or b == nil then
    noctalia.log("display-config: arrange needs exactly two outputs")
    return
  end
  local aw, ah = logicalSize(a)
  local bw, bh = logicalSize(b)
  local function place(o: Output, x: number, y: number)
    niri(o.name, "on")
    niri(o.name, "position", "set", "--", tostring(x), tostring(y))
  end
  if kind == "extend-right" then
    place(a, 0, 0)
    place(b, aw, 0)
  elseif kind == "extend-left" then
    place(b, 0, 0)
    place(a, bw, 0)
  elseif kind == "stack-above" then
    place(b, 0, 0)
    place(a, math.max(0, math.round((bw - aw) / 2)), bh)
  elseif kind == "stack-below" then
    place(a, 0, 0)
    place(b, math.max(0, math.round((aw - bw) / 2)), ah)
  elseif kind == "external-only" then
    place(b, 0, 0)
    niri(a.name, "off")
  elseif kind == "internal-only" then
    place(a, 0, 0)
    niri(b.name, "off")
  else
    noctalia.log("display-config: unknown arrangement " .. kind)
    return
  end
  armRevert()
  runQueue()
end

---------------------------------------------------------------------------
-- entry points

local function handle(op: string, arg: any)
  if op == "refresh" then
    fetch()
  elseif op == "toggle" then
    noctalia.togglePanel(PANEL)
  elseif op == "set" and type(arg) == "table" and type(arg.name) == "string" then
    setOutput(arg.name, arg)
  elseif op == "arrange" and type(arg) == "string" then
    arrange(arg)
  elseif op == "keep" then
    keep()
  elseif op == "revert" then
    revert()
  elseif op == "kanshiSwitch" and type(arg) == "string" then
    kanshictl({ "switch", arg })
  elseif op == "kanshiSave" and type(arg) == "string" then
    kanshiSave(arg)
  elseif op == "kanshiDelete" and type(arg) == "string" then
    kanshiDelete(arg)
  elseif op == "wdisplays" then
    noctalia.runAsync({ "wdisplays" })
  end
end

noctalia.state.watch("cmd", function(c: any)
  if type(c) == "table" and type(c.op) == "string" then
    handle(c.op, c.arg)
  end
end)

function onIpc(event: string, payload: string?)
  local arg: any = if payload ~= nil then noctalia.string.trim(payload) else nil
  -- set takes a JSON object, e.g. {"name":"eDP-1","scale":1.5}
  if event == "set" and arg ~= nil then
    arg = noctalia.json.decode(arg)
  end
  handle(event, arg)
end

function onOutputsChanged()
  fetch()
end

function onConfigChanged()
  fetch()
end

function update()
  if revertSnapshot ~= nil then
    local left = revertDeadline - os.time()
    if left <= 0 then
      revert()
    elseif left ~= snap.revertLeft then
      snap.revertLeft = left
      publish()
    end
  end
  if os.time() >= nextPoll then
    fetch()
  end
end

noctalia.setUpdateInterval(1000)
publish()
fetch()
